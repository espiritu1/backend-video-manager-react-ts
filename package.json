{
  "name": "api-video",
  "version": "1.0.0",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/server.ts",
    "build": "bun build src/server.ts --outdir ./dist",
    "generate": "bunx prisma generate",
    "db:push": "bun run -e 'await import(\"dotenv\").then(m => m.config())' node_modules/prisma/build/index.js db push",
    "db:studio": "bun run -e 'await import(\"dotenv\").then(m => m.config())' node_modules/prisma/build/index.js studio"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/express": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  }
}
