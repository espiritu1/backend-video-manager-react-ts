// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String

  parentId  Int?
  parent    Category?  @relation("RecursiveCategories", fields: [parentId], references: [id])
  children  Category[] @relation("RecursiveCategories")

  videos    Video[]

  @@unique([name])
  @@map("categories")
}

model Video {
  id               Int      @id @default(autoincrement())
  title            String
  description      String

  videoUrl         String
  thumbnailUrl    String

  categoryId       Int      // subcategoría
  parentCategoryId Int      // categoría principal (obligatorio)

  category         Category @relation(fields: [categoryId], references: [id])

  createdAt        DateTime @default(now())

  @@map("videos")
}
