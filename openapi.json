{
  "openapi": "3.0.3",
  "info": {
    "title": "Video Manager API",
    "description": "API REST para gestión de videos y categorías con soporte para subcategorías recursivas.\n\n## Características\n- CRUD de categorías (crear, listar, borrar)\n- CRUD de videos (crear, listar, borrar)\n- Soporte para subcategorías recursivas\n- Validación de datos con Zod",
    "version": "1.0.0",
    "contact": {
      "name": "Soporte",
      "email": "soporte@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Endpoints de verificación del servidor"
    },
    {
      "name": "Categories",
      "description": "Gestión de categorías y subcategorías"
    },
    {
      "name": "Videos",
      "description": "Gestión de videos"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Verificar estado del servidor",
        "description": "Retorna el estado actual del servidor",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Servidor funcionando correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "Listar todas las categorías",
        "description": "Retorna todas las categorías con sus subcategorías y videos relacionados",
        "operationId": "getAllCategories",
        "responses": {
          "200": {
            "description": "Lista de categorías obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "Crear una categoría",
        "description": "Crea una nueva categoría o subcategoría",
        "operationId": "createCategory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Categoría creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/categories/{id}": {
      "delete": {
        "tags": ["Categories"],
        "summary": "Eliminar una categoría",
        "description": "Elimina una categoría por su ID. No se puede eliminar si tiene subcategorías o videos asociados.",
        "operationId": "deleteCategory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la categoría a eliminar",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Categoría eliminada exitosamente"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/videos": {
      "get": {
        "tags": ["Videos"],
        "summary": "Listar todos los videos",
        "description": "Retorna todos los videos, opcionalmente filtrados por categoría",
        "operationId": "getAllVideos",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "description": "Filtrar videos por categoría",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de videos obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Video"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": ["Videos"],
        "summary": "Crear un video",
        "description": "Crea un nuevo video asociado a una categoría",
        "operationId": "createVideo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVideoRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Video creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/videos/{id}": {
      "delete": {
        "tags": ["Videos"],
        "summary": "Eliminar un video",
        "description": "Elimina un video por su ID",
        "operationId": "deleteVideo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del video a eliminar",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Video eliminado exitosamente"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "description": "Modelo de categoría con relaciones recursivas",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID único de la categoría",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nombre de la categoría",
            "example": "React"
          },
          "parentId": {
            "type": "integer",
            "nullable": true,
            "description": "ID de la categoría padre (null si es categoría principal)",
            "example": null
          },
          "parent": {
            "$ref": "#/components/schemas/Category"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "description": "Subcategorías de esta categoría"
          },
          "videos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Video"
            },
            "description": "Videos asociados a esta categoría"
          }
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Nombre de la categoría",
            "example": "React"
          },
          "parentId": {
            "type": "integer",
            "nullable": true,
            "description": "ID de la categoría padre (opcional, para subcategorías)",
            "example": null
          }
        }
      },
      "CategoryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/Category"
          }
        }
      },
      "Video": {
        "type": "object",
        "description": "Modelo de video",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID único del video",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Título del video",
            "example": "Tutorial useState"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Descripción del video",
            "example": "Aprende a usar useState en React"
          },
          "videoPath": {
            "type": "string",
            "description": "Ruta del archivo de video",
            "example": "/videos/tutorial-usestate.mp4"
          },
          "thumbnailPath": {
            "type": "string",
            "nullable": true,
            "description": "Ruta de la miniatura",
            "example": "/thumbnails/usestate.jpg"
          },
          "categoryId": {
            "type": "integer",
            "description": "ID de la categoría asociada",
            "example": 2
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de creación del video",
            "example": "2026-05-07T12:00:00.000Z"
          }
        }
      },
      "CreateVideoRequest": {
        "type": "object",
        "required": ["title", "description", "videoPath", "thumbnailPath", "categoryId"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Título del video",
            "example": "Tutorial useState"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "description": "Descripción del video",
            "example": "Aprende a usar useState en React"
          },
          "videoPath": {
            "type": "string",
            "minLength": 1,
            "description": "Ruta del archivo de video",
            "example": "/videos/tutorial-usestate.mp4"
          },
          "thumbnailPath": {
            "type": "string",
            "minLength": 1,
            "description": "Ruta de la miniatura del video",
            "example": "/thumbnails/usestate.jpg"
          },
          "categoryId": {
            "type": "integer",
            "description": "ID de la categoría a la que pertenece el video",
            "example": 2
          }
        }
      },
      "VideoResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/Video"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "description": "Mensaje de error",
            "example": "Error message"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Validation Error"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Campo que falló la validación",
                  "example": "name"
                },
                "message": {
                  "type": "string",
                  "description": "Mensaje de validación",
                  "example": "Name is required"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Solicitud incorrecta",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso no encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicto de datos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Error interno del servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}